{
  "name": "zdn-notes",
  "version": "1.8.0",
  "description": "",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:mcp && electron-vite dev",
    "build": "npm run build:mcp && electron-vite build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "postinstall": "electron-builder install-app-deps || echo \"[postinstall] node-pty 使用预编译二进制，跳过 electron 原生重编\"",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:ci": "npm run build && electron-builder --win --publish=never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "mcp": "tsx electron/mcp/index.ts",
    "mcp:stdio": "tsx electron/mcp/index.ts --stdio",
    "mcp:http": "tsx electron/mcp/index.ts --http",
    "mcp:stdio:dev": "electron-vite dev -- --zdn-mcp-stdio",
    "mcp:stdio:dev:debug": "cross-env ZDNOTES_MCP_INSPECT=9229 electron-vite dev -- --zdn-mcp-stdio",
    "mcp:test": "node scripts/test-mcp.mjs",
    "mcp:e2e": "tsx scripts/e2e-ipc-check.mts",
    "ztool": "node scripts/ztool.mjs"
  },
  "build": {
    "appId": "com.zdn.notes",
    "productName": "ZDNotes",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/agent-tools",
        "to": "agent-tools"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "docs/plugin-spec.md",
        "to": "plugin-spec.md"
      },
      {
        "from": "docs/agent-usage.md",
        "to": "agent-usage.md"
      },
      {
        "from": "resources/dsh",
        "to": "dsh"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ZDNotes-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "z-dn",
      "repo": "zdn-notes"
    }
  },
  "keywords": [],
  "author": "zdn",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@milkdown/core": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/theme-nord": "^7.21.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "adm-zip": "^0.6.0",
    "date-fns": "^3.6.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "marked": "^15.0.12",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.6.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.22.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
